{{- $publicToken := "" }}
{{- if eq .user.email "Zachary.Bugay@outlook.com" "zachary.bugay@outlook.com" }}
  {{- $publicToken = "personal-github.pub" }}
{{- else }}
  {{- $publicToken = "github_id_ed25519.pub" }}
{{- end }}
{{- $gitConfig := deepCopy .distributions.shared.gitConfig }}
{{- if eq .chezmoi.os "windows" }}
  {{- $gitConfig = mergeOverwrite $gitConfig .distributions.windows.gitConfig }}
{{- else if not (eq .chezmoi.os "darwin" "linux") }}
  {{- fail (printf "Unsupported operating system: %s" .chezmoi.os) }}
{{- end -}}
[user]
  name = {{ .user.name | quote }}
  email = {{ .user.email | quote }}
  signingkey = {{ .chezmoi.homeDir }}/.ssh/{{ $publicToken }}
{{- range $section, $settings := $gitConfig }}
[{{ $section }}]
{{- range $key, $value := $settings }}
  {{ $key }} = {{ if kindIs "string" $value }}{{ $value | quote }}{{ else }}{{ $value }}{{ end }}
{{- end }}
{{- end }}
[filter "lfs"]
  clean = {{ .chezmoi.config.git.command }}-lfs clean -- %f
  smudge = {{ .chezmoi.config.git.command }}-lfs smudge -- %f
  process = {{ .chezmoi.config.git.command }}-lfs filter-process
  required = true
[commit]
  template = ~/.config/git/gitmessage
  gpgsign = true
[gpg "ssh"]
  allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
