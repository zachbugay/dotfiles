# Performance tracking
_start_time=$SECONDS

# History Settings
export HISTFILE="${ZDOTDIR}/.zsh_history"
export HISTSIZE=10000
export SAVEHIST="$HISTSIZE"

# Shell options
# https://zsh.sourceforge.io/Doc/Release/Options.html
# https://github.com/rothgar/mastering-zsh/blob/master/docs/config/history.md
setopt APPEND_HISTORY         # Append to the history file.
setopt AUTO_CD                # Typing the directory name CD's into it. Best for interactive use only. Not for scripts.
setopt EXTENDED_HISTORY       # Write the history file in the "start:elapsed;command" format.
setopt HIST_EXPIRE_DUPS_FIRST # Delete duplicates first when HISTFILE size exceeds HISTSIZE.
setopt HIST_FIND_NO_DUPS      # Do not display a line previously find.
setopt HIST_IGNORE_ALL_DUPS   # Delete old recorded entry if new entry is a duplicate.
setopt HIST_IGNORE_DUPS       # Ignore duplicated commands history list.
setopt HIST_IGNORE_SPACE      # Don't record an entry starting with a space.
setopt HIST_REDUCE_BLANKS     # Remove superflous blanks before recording entry.
setopt HIST_SAVE_NO_DUPS      # Don't write duplicate entries in the history file.
setopt HIST_VERIFY            # Don't execute immediately upon history expansion.
setopt INC_APPEND_HISTORY     # Write to the history file immediately, not when the shell exits.
setopt SHARE_HISTORY          # Share history between sessions.

# When deleting with <C-w>, delete file names at a time.
WORDCHARS=${WORDCHARS/\/}

# TODO: Function that printenv in alphabetical order.
function _greeting() {
  fastfetch
}

{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
path=("$(brew --prefix rustup)/bin" $path)
{{- else }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
path+=(~/.cargo/bin ~/.local/bin)
{{- end }}

gitReposHome="${HOME}/source/repos"
zshPluginsPath="${XDG_CONFIG_HOME}/zsh/plugins"

# Setup directories
userDirectories=(
  "${gitReposHome}"
  "${zshPluginsPath}"
)

for directory in $userDirectories; do
  if [ ! -d $directory ]; then
    mkdir -p $directory
  fi
done

# Plugins
zshPlugins=(
  mattmc3/ez-compinit                         # Setup tab completions
  romkatv/zsh-no-ps2                          # Proper multi-line commands
  zdharma-continuum/fast-syntax-highlighting  # Syntax highlighting
  zsh-users/zsh-autosuggestions               # Auto-suggestions
  zsh-users/zsh-completions                   # Add completions for more cmds
  zsh-users/zsh-history-substring-search      # Up/Down to search history
)

for plugin in $zshPlugins; do
  if ! [[ -d $zshPluginsPath/$plugin ]]; then
    git clone https://github.com/$plugin $zshPluginsPath/$plugin
  fi
  source $zshPluginsPath/$plugin/${plugin:t}.plugin.zsh
done

# Functions for completion sources.
fpath=($ZDOTDIR/func $fpath)

funcs=(
  up
  printpath
)

for func in $funcs; do
  autoload -Uz $ZDOTDIR/func/$func
done

# Use a completion menu.
zstyle ':completion:*' menu select

source ${ZDOTDIR}/zaliases.zsh

# This is my Ubuntu WSL config changes
# TODO: Keybindings own file.
# bindkey "^[[1;5D" backward-word
# bindkey "^[[1;5C" forward-word

source <(sk --shell zsh)

# NVM Node Version Manager
export NVM_DIR="${XDG_CONFIG_HOME}/nvm"

# DOTNET_ROOT for other apps to know I have dotnet.
export DOTNET_ROOT="${HOMEBREW_PREFIX}/opt/dotnet/libexec"

if [ ! -d "${DOCKER_CONFIG}/cli-plugins" ]; then
  mkdir -p "${DOCKER_CONFIG}/cli-plugins"
fi

dockerPlugins=(
  docker-compose
  docker-buildx
)

for plugin in $dockerPlugins; do
  if [ ! -h "${DOCKER_CONFIG}/cli-plugins/$plugin" ]; then
   ln -sfn $(brew --prefix)/opt/$plugin/bin/$plugin "${DOCKER_CONFIG}/cli-plugins/$plugin"
  fi
done


# TODO: Check if NVM exists. If so, then do this.
# NVM has to already be installed for this to work.
# A conditional that ensures nvm.sh is a file, and is not empty.
# The Logical AND operator ensures subsequent commands will run only if the previous was successful.
# The . (dot) command is the source command. It is used to execute commands from a file in the current shell.
[ -s "${NVM_DIR}/nvm.sh" ] && . "${NVM_DIR}/nvm.sh"  # This loads nvm
NVM_BASH_COMPLETION=""

if which brew > /dev/null 2>&1; then
  NVM_BASH_COMPLETION="${HOMEBREW_REPOSITORY}/opt/nvm/etc/bash_completion.d/nvm"
else
  NVM_BASH_COMPLETION="${NVM_DIR}/bash_completion"
fi

# Load nvm bash completion
[ -s "${NVM_BASH_COMPLETION}" ] && . "${NVM_BASH_COMPLETION}"

# Finally, activate the prompt.
eval "$(starship init zsh)"

# Print fastfetch
_greeting

# Performance warning
_end_time=$SECONDS
_load_time=$((_end_time - _start_time))
if ((_load_time > 3)); then
  echo "⚠️ Shell startup took ${_load_time}s. Consider optimizing further."
fi

