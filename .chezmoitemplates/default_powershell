# Functions
function touch {
  param([string[]]$Files)

  foreach ($file in $Files) {
    # https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_automatic_variables?view=powershell-7.6#executioncontext
    $resolvedPath = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($file)
    if ([System.IO.File]::Exists($resolvedPath)) {
      $now = [System.DateTime]::UtcNow
      [System.IO.File]::SetLastWriteTimeUtc($resolvedPath, $now)
      [System.IO.File]::SetLastAccessTimeUtc($resolvedPath, $now)
    }
    else {
      [System.IO.File]::Create($resolvedPath).Dispose()
    }
  }
}

function Initialize-VsDevPowerShell {
  $vsWhere = "${Env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe"
  $vsPath = (& $vsWhere -latest -products * -prerelease -property installationPath).Trim()
  Import-Module (Get-ChildItem $vsPath -Recurse -File -Filter Microsoft.VisualStudio.DevShell.dll).FullName
  Enter-VsDevShell -VsInstallPath $vsPath -SkipAutomaticLocation -HostArch "arm64" -Arch "arm64"
}

