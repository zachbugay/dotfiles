{{- /* chezmoi:modify-template */ }}
{{- $data := dict }}
{{- if .chezmoi.stdin }}
{{-   $data = fromJson .chezmoi.stdin }}
{{- end -}}
{{- if eq .chezmoi.os "windows" }}
{{-   $data = $data | setValueAtPath "currentContext" .distributions.windows.docker_context }}
{{- end -}}
{{ toPrettyJson $data }}
