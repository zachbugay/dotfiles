{{- /* chezmoi:modify-template */ }}
{{- $data := dict }}
{{- if .chezmoi.stdin }}
{{-   $data = fromJson .chezmoi.stdin }}
{{- end -}}
{{- if eq .chezmoi.os "windows" }}
{{-   $virusTotalApiKey := azureKeyVault "virustotal-apikey" }}
{{-   $scoopConfig := dict "scoop_branch" "develop" "shim" "scoop-shim-rust" "use_sqlite_cache" "true" "virustotal_apikey" $virusTotalApiKey }}
{{-   $data := merge $data $scoopConfig}}
{{- end -}}
{{ toPrettyJson $data }}
