{
  "typescript": {
    "useTabs": false,
    "semiColons": "always",
    "quoteStyle": "preferDouble",
  },
  "json": {
    "useTabs": false,
    "indentWidth": 2,
    "trailingCommas": "jsonc",
  },
  "markdown": {},
  "toml": {
    "useTabs": false,
    "indentWidth": 2,
  },
  "malva": {},
  "markup": {},
  "yaml": {},
  "excludes": ["**/node_modules", "**/*-lock.json"],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.27.1",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/roslyn@0.23.4"
  ],
}
