{
  "excludes": ["**/node_modules", "**/*-lock.json"],
  "indentWidth": 2,
  "lineWidth": 160,
  "newLineKind": "lf",
  "quoteStyle": "preferDouble",
  "semicolons": "always",
  "useTabs": false,
  "shebangs": {
    "#!/bin/sh": "sh",
    "#!/usr/bin/env bash": "sh",
    "#!/usr/bin/env zsh": "zsh",
    "#!/usr/bin/env deno run": "ts",
  },
  "json": {
    "trailingCommas": "jsonc",
  },
  "plugins": [
    "npm:@dprint/typescript@0.99.1",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/roslyn@0.24.0",
    "npm:@dprint/dockerfile@0.8.0",
    "npm:@dprint/sql@0.5.0",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20",
    "npm:@dprint/shfmt@0.2.0",
    "npm:@dprint/terraform@0.2.0",
    "https://plugins.dprint.dev/jolars/badness-v1.4.1.wasm",
    "npm:@dprint/stylua@0.2.0",
  ],
}
