{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

brew bundle --file=/dev/stdin <<EOF
{{- range .distributions.darwin.brews }}
brew {{ . | quote }}
{{- end }}
{{- range .distributions.darwin.headbrews }}
brew {{ . | quote }}, args: ["HEAD"]
{{- end -}}
{{- range .distributions.darwin.casks }}
cask {{ . | quote -}}
{{- end }}
EOF

# Install rustup toolchain for nightly builds.
rustup toolchain install nightly-aarch64-apple-darwin

npm install -g prettier prettier-plugin-powershell

{{- end }}

